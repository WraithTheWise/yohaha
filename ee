    -- Layout files are separate from control configurations.
    Library.ValidateLayout = function(self, State)
        if type(State) ~= "table" or State.Version ~= 1 then return nil end
        for _, Key in {"X", "Y", "Width", "Height", "Page"} do
            local Number = State[Key]
            if type(Number) ~= "number" or Number ~= Number or MathAbs(Number) == math.huge then return nil end
        end
        if State.Width <= 0 or State.Height <= 0 or State.Page < 1 then return nil end
        return {Version = 1, X = State.X, Y = State.Y, Width = State.Width, Height = State.Height,
            Page = MathFloor(State.Page), Category = type(State.Category) == "string" and State.Category or nil}
    end

    Library.HighlightMatch = function(self, Text, Query)
        Text = tostring(Text)
        local function Escape(Value)
            return (Value:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
        end
        if Query == "" then return Escape(Text) end
        local Color = self.Theme.Accent
        local Tag = StringFormat('<font color="rgb(%d,%d,%d)"><b>', MathFloor(Color.R * 255), MathFloor(Color.G * 255), MathFloor(Color.B * 255))
        local Parts, Cursor = {}, 1
        while true do
            local First, Last = StringFind(StringLower(Text), Query, Cursor, true)
            if not First then TableInsert(Parts, Escape(Text:sub(Cursor))); break end
            TableInsert(Parts, Escape(Text:sub(Cursor, First - 1)))
            TableInsert(Parts, Tag .. Escape(Text:sub(First, Last)) .. "</b></font>")
            Cursor = Last + 1
        end
        return TableConcat(Parts)
    end

    Library.ApplySearch = function(self, Window, Query)
        for Label, State in Window.SearchLabels or {} do
            if Label.Parent then Label.Text = State.Text; Label.RichText = State.RichText end
        end
        for Element, Visible in Window.SearchElements or {} do
            if Element.Parent then Element.Visible = Visible end
        end
        for Section, State in Window.SearchSections or {} do
            if Section.Items["Section"].Instance.Parent then
                Section.Items["Section"].Instance.Visible = State.Visible
                Section:SetCollapse(State.Open)
            end
        end
        Window.SearchLabels, Window.SearchElements, Window.SearchSections = {}, {}, {}
        Window.SearchQuery = StringLower(tostring(Query or "")):match("^%s*(.-)%s*$")
        local QueryText = Window.SearchQuery
        Window.Items["SearchClear"].Instance.Visible = tostring(Query or "") ~= ""
        Window.Items["SearchEmpty"].Instance.Visible = false
        Window.Items["SearchCount"].Instance.Text = ""
        local Page = self.CurrentPage
        if not Page or Page.Window ~= Window or QueryText == "" then return end
        local Matches, Count = {}, 0
        for _, Column in Page.ColumnsData do Column.Instance.CanvasPosition = Vector2New(0, 0) end
        local function Highlight(Label)
            if not Label or Label.RichText then return end
            Window.SearchLabels[Label] = {Text = Label.Text, RichText = Label.RichText}
            Label.RichText = true
            Label.Text = self:HighlightMatch(Label.Text, QueryText)
        end
        for _, Entry in self.SearchItems[Page] or {} do
            local Element, Section = Entry.Element.Instance, Entry.Section
            local SectionMatch = Section and StringFind(StringLower(Section.Name), QueryText, 1, true)
            local Match = SectionMatch or StringFind(StringLower(tostring(Entry.Name)), QueryText, 1, true)
            Window.SearchElements[Element] = Element.Visible
            Element.Visible = Element.Visible and Match ~= nil
            if Element.Visible and (not Section or Section.Items["Section"].Instance.Visible) then
                Count += 1
                if Section then Matches[Section] = true end
                for _, Child in Element:GetChildren() do
                    if Child:IsA("TextLabel") and Child.Text == tostring(Entry.Name) then Highlight(Child); break end
                end
            end
        end
        for _, Section in Page.SectionList do
            local Frame = Section.Items["Section"].Instance
            Window.SearchSections[Section] = {Visible = Frame.Visible, Open = Section.IsOpen}
            Frame.Visible = Frame.Visible and Matches[Section] == true
            if Frame.Visible then Section:SetCollapse(true); Highlight(Section.Items["Text"].Instance) end
        end
        Window.Items["SearchEmpty"].Instance.Visible = Count == 0
        Window.Items["SearchCount"].Instance.Text = StringFormat("%d match%s on this page", Count, Count == 1 and "" or "es")
    end

    Library.PositionPopup = function(self, Popup, Button, Height)
        local Viewport = Workspace.CurrentCamera.ViewportSize
        local Position = Button.AbsolutePosition
        local Size = Button.AbsoluteSize
        local Width = Popup.Size.X.Offset
        local X = MathClamp(Position.X + Size.X - Width, 8, math.max(8, Viewport.X - Width - 8))
        local Y = Position.Y + Size.Y + 8
        if Y + Height > Viewport.Y - 44 then
            Y = Position.Y - Height - 8
        end
        Popup.Position = UDim2FromOffset(X, math.max(8, Y))
    end

