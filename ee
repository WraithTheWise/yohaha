            local Window = {
                Name = Data.Name or Data.name or "Window",
                SubTitle = Data.SubTitle or Data.subtitle or "",
                Icon = Data.Icon or nil,

                Pages = { },
                Items = { },
                IsOpen = false
            }

            Library.CurrentWindow = Window
            Window.Items = { }
            Window.RememberLayout = Data.RememberLayout ~= false
            local LayoutKey = tostring(game.GameId) .. ":" .. tostring(Data.LayoutKey or Window.Name)
            local Hash = 0
            for Index = 1, #LayoutKey do Hash = (Hash * 31 + string.byte(LayoutKey, Index)) % 2147483647 end
            Window.LayoutPath = FolderDirectory .. "/Layout_" .. tostring(Hash) .. ".json"
            if Window.RememberLayout and type(readfile) == "function" then
                local Ok, State = pcall(function() return HttpService:JSONDecode(readfile(Window.LayoutPath)) end)
                Window.SavedLayout = Ok and Library:ValidateLayout(State) or nil
                Window.PendingPage = Window.SavedLayout and Window.SavedLayout.Page or nil
            end

            function Window:SaveLayout(Force)
                if not Window.LayoutReady or not Window.RememberLayout or type(writefile) ~= "function" then return end
                local Frame = Window.Items["MainFrame"].Instance
                local PageIndex, Category = Window.PendingPage or 1, nil
                for Index, Page in Window.Pages do
                    if Page.Active then
                        PageIndex = Window.PendingPage or Index
                        Category = Page.PendingCategory or Page.SelectedCategory
                        break
                    end
                end
                local State = {Version = 1, X = math.round(Frame.Position.X.Offset), Y = math.round(Frame.Position.Y.Offset),
                    Width = math.round(Frame.Size.X.Offset), Height = math.round(Frame.Size.Y.Offset), Page = PageIndex,
                    Category = Window.PendingPage and Window.SavedLayout.Category or Category}
                local Signature = StringFormat("%d:%d:%d:%d:%d:%s", State.X, State.Y, State.Width, State.Height, State.Page, State.Category or "")
                if Signature ~= Window.LayoutSignature then
                    Window.LayoutSignature, Window.LayoutChangedAt = Signature, os.clock()
                end
                if Signature == Window.SavedSignature or (not Force and os.clock() - Window.LayoutChangedAt < 0.6) then return end
                InitFolders()
                local Ok, Error = pcall(function() writefile(Window.LayoutPath, HttpService:JSONEncode(State)) end)
